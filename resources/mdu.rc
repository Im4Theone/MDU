#include <winres.h>
#include "version.h"

1 ICON "icons/mdu.ico"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "mdu.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION MDU_VERSION_MAJOR,MDU_VERSION_MINOR,MDU_VERSION_PATCH,0
 PRODUCTVERSION MDU_VERSION_MAJOR,MDU_VERSION_MINOR,MDU_VERSION_PATCH,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "MDU - Miku Desktop Unit"
            VALUE "FileVersion", MDU_VERSION_STRING
            VALUE "ProductName", "MDU"
            VALUE "ProductVersion", MDU_VERSION_STRING
            VALUE "LegalCopyright", "MIT License"
            VALUE "OriginalFilename", "mdu.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
